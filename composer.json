{
    "name": "mohamedtarek/laravel-stampede-guard",
    "description": "Cache stampede prevention for Laravel: atomic-lock remember and XFetch probabilistic early expiration.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "cache", "stampede", "thundering-herd", "xfetch", "lock"],
    "authors": [
        { "name": "Mohamed Tarek" }
    ],
    "require": {
        "php": "^7.3|^8.0",
        "illuminate/bus": "^8.0|^9.0|^10.0",
        "illuminate/cache": "^8.0|^9.0|^10.0",
        "illuminate/contracts": "^8.0|^9.0|^10.0",
        "illuminate/events": "^8.0|^9.0|^10.0",
        "illuminate/queue": "^8.0|^9.0|^10.0",
        "illuminate/support": "^8.0|^9.0|^10.0",
        "laravel/serializable-closure": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "nunomaduro/larastan": "^1.0|^2.0",
        "orchestra/testbench": "^6.4|^7.0|^8.0",
        "phpunit/phpunit": "^9.5.10|^10.5"
    },
    "autoload": {
        "psr-4": { "MohamedTarek\\Stampede\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "MohamedTarek\\Stampede\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "if [ -f vendor/bin/pint ]; then vendor/bin/pint --test; else echo 'pint not installed on this PHP'; fi",
        "fix": "pint"
    },
    "extra": {
        "laravel": {
            "providers": ["MohamedTarek\\Stampede\\StampedeServiceProvider"]
        },
        "branch-alias": { "dev-2.x": "2.x-dev" }
    },
    "config": {
        "sort-packages": true,
        "audit": { "block-insecure": false }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
