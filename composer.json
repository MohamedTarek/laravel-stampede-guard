{
    "name": "mohamedtarek/laravel-stampede-guard",
    "description": "Cache stampede prevention for Laravel: atomic-lock remember and XFetch probabilistic early expiration.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "cache", "stampede", "thundering-herd", "xfetch", "lock"],
    "authors": [
        { "name": "Mohamed Tarek" }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/bus": "^11.0|^12.0|^13.0",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "laravel/serializable-closure": "^1.3|^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.6|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": { "MohamedTarek\\Stampede\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "MohamedTarek\\Stampede\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint --test",
        "fix": "pint"
    },
    "extra": {
        "laravel": {
            "providers": ["MohamedTarek\\Stampede\\StampedeServiceProvider"]
        },
        "branch-alias": { "dev-main": "3.x-dev" }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
